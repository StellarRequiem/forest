#!/usr/bin/env bash
# forest-review — Proposal queue browser for Forest CUS
# Usage: forest-review [--summary | --clear]
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FOREST_DIR="$(dirname "$SCRIPT_DIR")"
source "$FOREST_DIR/venv/bin/activate" 2>/dev/null
python3 "$FOREST_DIR/tools/review.py" "$@"
