#!/usr/bin/env bash
# Forest Dashboard launcher — runs Streamlit on port 8501
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FOREST_DIR="$(dirname "$SCRIPT_DIR")"

source "$FOREST_DIR/venv/bin/activate" 2>/dev/null || true

echo "🌲 Starting Forest Dashboard at http://localhost:8501"
exec streamlit run "$FOREST_DIR/dashboard/app.py" \
    --server.headless true \
    --server.port 8501 \
    "$@"
