#!/usr/bin/env bash
# forest-audit — Audit chain integrity verifier for Forest CUS
# Usage: forest-audit [--full | --tail N | --events | --stats]
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FOREST_DIR="$(dirname "$SCRIPT_DIR")"
source "$FOREST_DIR/venv/bin/activate" 2>/dev/null
python3 "$FOREST_DIR/tools/audit.py" "$@"
