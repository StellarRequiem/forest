# Forest CUS — environment configuration template
# Copy this file to .env and fill in the values you want to use.
# The system runs without any of these set — they are all optional.

# ── Threat Intel ──────────────────────────────────────────────────────────────
# AbuseIPDB API key for checking external IPs against known-malicious sources.
# Free tier: 1,000 checks/day, no credit card required.
# Sign up at: https://www.abuseipdb.com
# Results are cached for 24 hours in ~/ForestVault/intel_cache.json.

ABUSEIPDB_API_KEY=

# Minimum confidence score (0-100) before an IP is reported as a finding.
# 25 = flag anything with even a small number of reports (more noise)
# 50 = flag IPs with moderate abuse history
# 75 = flag only high-confidence confirmed malicious IPs (less noise)
# Default: 25

ABUSEIPDB_THRESHOLD=25

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Port for the Streamlit dashboard. Default: 8501

STREAMLIT_PORT=8501

# ── Monitoring ────────────────────────────────────────────────────────────────
# Default interval (minutes) for --continuous mode. Default: 30

FOREST_INTERVAL=30

# Score threshold for desktop alerts in --continuous --alert mode.
# Cycles where any worker scores below this will trigger a macOS notification.
# Default: 70

FOREST_ALERT_THRESHOLD=70
